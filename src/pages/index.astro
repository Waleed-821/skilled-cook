<script>
  const menuToggle = document.getElementById("menu-toggle");
  const menuClose = document.getElementById("menu-close");
  const sideMenu = document.getElementById("side-menu");
  const menuOverlay = document.getElementById("menu-overlay");

  function openSideMenu() {
    sideMenu.classList.add("active");
    menuOverlay.classList.add("active");
    menuToggle.setAttribute("aria-expanded", "true");
    sideMenu.setAttribute("aria-hidden", "false");
  }

  function closeSideMenu() {
    sideMenu.classList.remove("active");
    menuOverlay.classList.remove("active");
    menuToggle.setAttribute("aria-expanded", "false");
    sideMenu.setAttribute("aria-hidden", "true");
  }

  menuToggle.addEventListener("click", openSideMenu);
  menuClose.addEventListener("click", closeSideMenu);
  menuOverlay.addEventListener("click", closeSideMenu);

  sideMenu.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", closeSideMenu);
  });

  document.addEventListener("keydown", event => {
    if (event.key === "Escape") closeSideMenu();
  });
</script>

<script>
  // إنشاء زر الوضع الفاتح والداكن
  const themeButton = document.createElement("button");

  themeButton.type = "button";
  themeButton.className = "theme-toggle";
  themeButton.setAttribute("aria-label", "تغيير مظهر الموقع");

  // قراءة الوضع المحفوظ
  const savedTheme = localStorage.getItem("site-theme") || "dark";

  document.documentElement.dataset.theme = savedTheme;

  function updateThemeButton() {
    themeButton.textContent =
      document.documentElement.dataset.theme === "dark" ? "☀" : "☾";
  }

  updateThemeButton();

  // وضع الزر بجوار قائمة اللغة
  const header = document.querySelector(".header");
  const languageMenu = header?.querySelector(".language-menu");
  const logo = header?.querySelector(".logo");

  if (languageMenu) {
    languageMenu.insertAdjacentElement("afterend", themeButton);
  } else if (logo) {
    logo.insertAdjacentElement("afterend", themeButton);
  }

  // التبديل بين الوضعين
  themeButton.addEventListener("click", () => {
    const currentTheme = document.documentElement.dataset.theme;

    const newTheme = currentTheme === "dark" ? "light" : "dark";

    document.documentElement.dataset.theme = newTheme;

    localStorage.setItem("site-theme", newTheme);

    updateThemeButton();
  });
</script>


<script>
  const kitchenWindow = document.querySelector(".kitchen-carousel-window");
  const kitchenTrack = document.querySelector(".kitchen-carousel-track");
  const kitchenPrev = document.querySelector(".kitchen-arrow-prev");
  const kitchenNext = document.querySelector(".kitchen-arrow-next");
  const kitchenCaption = document.querySelector(".kitchen-caption");

  if (kitchenWindow && kitchenTrack && kitchenPrev && kitchenNext) {
    const originalSlides = Array.from(kitchenTrack.children);

    if (originalSlides.length > 1) {
      const firstClone = originalSlides[0].cloneNode(true);
      const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true);

      firstClone.setAttribute("aria-hidden", "true");
      lastClone.setAttribute("aria-hidden", "true");

      kitchenTrack.appendChild(firstClone);
      kitchenTrack.insertBefore(lastClone, originalSlides[0]);

      let currentSlide = 1;
      let scrollTimer;

      const allSlides = () => Array.from(kitchenTrack.children);

      const updateCaption = (index) => {
        const realIndex = Math.max(
          0,
          Math.min(index - 1, originalSlides.length - 1)
        );

        const caption = originalSlides[realIndex]?.dataset.caption;

        if (kitchenCaption && caption) {
          kitchenCaption.textContent = caption;
        }
      };

      const centerSlide = (index, behavior = "smooth") => {
        const slide = allSlides()[index];
        if (!slide) return;

        const left =
          slide.offsetLeft -
          (kitchenWindow.clientWidth - slide.clientWidth) / 2;

        kitchenWindow.scrollTo({
          left,
          behavior
        });
      };

      const goTo = (index) => {
        currentSlide = index;
        updateCaption(currentSlide);
        centerSlide(currentSlide);
      };

      kitchenPrev.addEventListener("click", () => {
        goTo(currentSlide - 1);
      });

      kitchenNext.addEventListener("click", () => {
        goTo(currentSlide + 1);
      });

      kitchenWindow.addEventListener("scroll", () => {
        const slides = allSlides();
        const center =
          kitchenWindow.scrollLeft + kitchenWindow.clientWidth / 2;

        let nearest = 0;
        let distance = Infinity;

        slides.forEach((slide, index) => {
          const slideCenter =
            slide.offsetLeft + slide.clientWidth / 2;

          const nextDistance = Math.abs(slideCenter - center);

          if (nextDistance < distance) {
            distance = nextDistance;
            nearest = index;
          }
        });

        currentSlide = nearest;
        updateCaption(currentSlide);

        if (nearest === 0 || nearest === slides.length - 1) {
          clearTimeout(scrollTimer);

          scrollTimer = window.setTimeout(() => {
            const realIndex =
              nearest === 0 ? originalSlides.length : 1;

            currentSlide = realIndex;
            centerSlide(realIndex, "auto");
            updateCaption(realIndex);
          }, 220);
        }
      }, { passive: true });

      window.addEventListener("load", () => {
        centerSlide(1, "auto");
        updateCaption(1);
      }, { once: true });

      requestAnimationFrame(() => {
        centerSlide(1, "auto");
        updateCaption(1);
      });
    }
  }
</script>

