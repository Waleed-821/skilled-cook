      /* تصغير قسم من نحن */
      .intro { padding: 65px 12%; }
      .intro h2 { font-size: 36px; margin: 8px 0; }
      .intro p:last-child { max-width: 650px; line-height: 2; }

      /* جولة داخل المطبخ */
      .kitchen-tour {
        padding: 85px 8%;
        background: #11100e;
        text-align: center;
        direction: rtl;
      }
      .kitchen-tour-header { max-width: 850px; margin: 0 auto 45px; }
      .kitchen-tour h2 {
        color: var(--cream);
        font-size: 36px;
        font-weight: 900;
        margin: 10px 0 25px;
      }
      .kitchen-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        margin: 20px 0;
      }
      .kitchen-stat strong {
        color: var(--gold);
        font-size: 62px;
        font-weight: 900;
        line-height: 1.3;
        direction: ltr;
      }
      .kitchen-stat span { color: var(--muted); font-size: 15px; }
      .kitchen-description {
        max-width: 760px;
        margin: 25px auto;
        color: #c3bbb0;
        font-size: 15px;
        line-height: 2.2;
      }
      .kitchen-highlight {
        color: var(--gold);
        font-size: 17px;
        font-weight: 800;
        margin-top: 25px;
      }
      .kitchen-carousel {
        position: relative;
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .kitchen-carousel-window {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
        direction: ltr;
        padding: 12px 0 22px;
        touch-action: pan-x;
      }
      .kitchen-carousel-window::-webkit-scrollbar { display: none; }
      .kitchen-carousel-track {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        width: max-content;
        padding: 0 calc((100vw - min(100vw - 180px, 760px)) / 2);
      }
      .kitchen-slide {
        flex: 0 0 min(72vw, 760px);
        width: min(72vw, 760px);
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 16px;
        border: 1px solid #d99a5370;
        background: #1b1814;
        scroll-snap-align: center;
        box-shadow: 0 12px 34px #0005;
      }
      .kitchen-slide img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .kitchen-arrow {
        flex: 0 0 48px;
        width: 48px;
        height: 48px;
        border: 1px solid var(--gold);
        border-radius: 50%;
        background: #211b14;
        color: var(--gold);
        font-size: 23px;
        line-height: 1;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: background .2s ease, color .2s ease, transform .2s ease;
        z-index: 2;
      }
      .kitchen-arrow:hover {
        background: var(--gold);
        color: #17120d;
        transform: scale(1.06);
      }

      /* الوضع الفاتح */
