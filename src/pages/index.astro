      @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap');

      :root {
        --black: #090909;
        --surface: #11100e;
        --gold: #d99a53;
        --cream: #f3e7d2;
        --muted: #aaa29a;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--black);
        color: var(--cream);
        font-family: 'Cairo', sans-serif;
      }

      a { color: inherit; text-decoration: none; }
      .header {
        min-height: 88px;
        padding: 18px 7%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #ffffff15;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 14px;
        width: auto;
        min-width: 0;
        height: 65px;
        overflow: visible;
        flex-shrink: 0;
      }

      .logo img {
        width: 80px;
        height: 95px;
        object-fit: contain;
        display: block;
        flex-shrink: 0;
      }

      .logo span {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        white-space: nowrap;
        line-height: 1.4;
      }

      .logo strong {
        color: var(--gold);
        font-size: 18px;
        font-weight: 800;
      }

      .logo small {
        color: #ffffff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 2px;
      }

      h1 span, h2 span { color: var(--gold); }
      nav { display: flex; gap: 32px; color: #ddd2c3; font-size: 14px; }
      nav a:hover { color: var(--gold); }

      .contact-button, .gold-button {
        background: var(--gold);
        color: #17100a;
        padding: 12px 23px;
        font-weight: 800;
        display: inline-block;
      }

      .hero {
        min-height: 650px;
        padding: 100px 10%;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        align-items: center;
        gap: 50px;
        background: radial-gradient(ellipse at 15% 45%, #49301d55, transparent 48%);
      }

      .eyebrow { color: var(--gold); font-size: 13px; font-weight: 700; letter-spacing: 1px; }
      h1 { font-size: clamp(42px, 5vw, 68px); line-height: 1.45; margin: 20px 0; font-weight: 900; }
      .description { color: var(--muted); max-width: 550px; line-height: 2.2; font-size: 16px; }
      .hero-actions { display: flex; align-items: center; gap: 30px; margin-top: 35px; }
