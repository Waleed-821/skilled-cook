/* ألوان الوضع الفاتح */
html[data-theme="light"] {
  --black: #f7f5f0;
  --surface: #ffffff;
  --gold: #a97837;
  --cream: #30271e;
  --muted: #756b60;
}

/* الخلفية العامة */
html[data-theme="light"] body {
  background: #f7f5f0;
  color: #30271e;
}

/* الشريط العلوي */
html[data-theme="light"] .header {
  background: #ffffff;
  border-bottom-color: #e8dfd1;
}

html[data-theme="light"] .logo strong {
  color: #95652d;
}

html[data-theme="light"] .logo small {
  color: #4b4034;
}

html[data-theme="light"] nav {
  color: #51483d;
}

/* الأزرار */
html[data-theme="light"] .contact-button,
html[data-theme="light"] .gold-button {
  background: #a97837;
  color: #ffffff;
}

/* القسم الرئيسي */
html[data-theme="light"] .hero {
  background:
    radial-gradient(
      ellipse at 15% 45%,
      rgba(201, 155, 91, 0.16),
      transparent 48%
    );
}

html[data-theme="light"] .description {
  color: #6e6255;
}

html[data-theme="light"] .gold-circle {
  border-color: #c99b5b;
  box-shadow:
    0 0 70px rgba(169, 120, 55, 0.08),
    inset 0 0 50px rgba(169, 120, 55, 0.06);
}

/* قسم من نحن */
html[data-theme="light"] .intro {
  background: #eee7da;
  color: #30271e;
}

html[data-theme="light"] .intro p:last-child {
  color: #62584d;
}

/* الخدمات */
html[data-theme="light"] .services {
  background: #f7f5f0;
}

html[data-theme="light"] .service-grid article {
  background: #ffffff;
  border-color: #e5dac9;
  box-shadow: 0 5px 20px rgba(65, 45, 20, 0.05);
}

html[data-theme="light"] .service-grid h3 {
  color: #493827;
}

html[data-theme="light"] .service-grid p {
  color: #756b60;
}

/* سابقة الأعمال */
html[data-theme="light"] .portfolio {
  background: #eee9df;
}

html[data-theme="light"] .portfolio h2 {
  color: #493827;
}

html[data-theme="light"] .portfolio-box {
  background: linear-gradient(145deg, #ffffff, #f8f4ec);
  border-color: #d8bd95;
  box-shadow: 0 12px 35px rgba(65, 45, 20, 0.08);
}

html[data-theme="light"] .portfolio-year {
  border-bottom-color: #e6d8c3;
}

html[data-theme="light"] .portfolio-year li {
  color: #51483d;
}

/* القسم الختامي */
html[data-theme="light"] .closing {
  background: #e9dfd0;
  color: #30271e;
}

html[data-theme="light"] .closing p:not(.eyebrow) {
  color: #62584d;
}

/* القائمة الجانبية */
html[data-theme="light"] .side-menu {
  background: #ffffff;
  box-shadow: 8px 0 30px rgba(65, 45, 20, 0.12);
}

html[data-theme="light"] .side-menu-links a {
  color: #493827;
  border-bottom-color: #eee5d8;
}

html[data-theme="light"] .side-menu-header {
  color: #95652d;
}

html[data-theme="light"] .menu-close {
  color: #95652d;
}

/* قائمة اللغة */
html[data-theme="light"] .language-toggle,
html[data-theme="light"] .language-options {
  background: #ffffff;
  border-color: #c99b5b;
}

html[data-theme="light"] .language-options button:hover,
html[data-theme="light"] .language-options button.active {
  background: #f0e6d6;
}

/* بروفايل المطبخ */
html[data-theme="light"] .profile-nav {
  color: #805629;
  background: rgba(201, 155, 91, 0.10);
}

/* التذييل */
html[data-theme="light"] footer {
  background: #ffffff;
  color: #756b60;
  border-top-color: #e8dfd1;
}

/* زر القائمة */
html[data-theme="light"] .menu-toggle {
  background: #ffffff;
  border-color: #c99b5b;
}

/* تحسين الجوال */
@media (max-width: 750px) {
  html[data-theme="light"] nav {
    border-top-color: #e8dfd1;
  }
