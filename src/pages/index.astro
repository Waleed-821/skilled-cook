      [dir="ltr"] .logo span { align-items: flex-start; }
      
/* القائمة الجانبية */
.menu-toggle {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 42px;
  height: 42px;
  padding: 9px;
  border: 1px solid rgba(190, 145, 75, 0.4);
  border-radius: 9px;
  background: transparent;
  cursor: pointer;
  flex-shrink: 0;
}

.menu-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background: #c69a55;
  border-radius: 3px;
}

.menu-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9998;
  opacity: 0;
  visibility: hidden;
  transition: 0.3s ease;
}

.side-menu {
  position: fixed;
  top: 0;
  left: 0;
  width: min(320px, 85%);
  height: 100vh;
  background: #171717;
  z-index: 9999;
  padding: 28px 24px;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  direction: rtl;
  box-shadow: 8px 0 30px rgba(0, 0, 0, 0.25);
}

.side-menu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 22px;
  border-bottom: 1px solid rgba(198, 154, 85, 0.25);
  color: #c69a55;
  font-size: 18px;
}

.menu-close {
  background: transparent;
  border: 0;
  color: #c69a55;
  font-size: 30px;
  cursor: pointer;
}

.side-menu-links {
  display: flex;
  flex-direction: column;
  margin-top: 20px;
}

.side-menu-links a {
  display: block;
  padding: 17px 5px;
  color: #f5f0e6;
  text-decoration: none;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  transition: 0.2s;
}

.side-menu-links a:hover {
  color: #c69a55;
  padding-right: 12px;
}

.menu-overlay.active {
  opacity: 1;
  visibility: visible;
}

.side-menu.active {
  transform: translateX(0);
}

