      }

      .language-toggle img, .language-options img {
        width: 24px;
        height: 16px;
        object-fit: cover;
        display: block;
        border-radius: 2px;
      }

      .language-arrow { color: #d6ad68; font-size: 14px; }

      .language-options {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 44px;
        padding: 5px;
        background: #242424;
        border: 1px solid #b88646;
        border-radius: 8px;
        z-index: 1000;
        gap: 5px;
      }

      .language-options.show { display: flex; flex-direction: column; }
      .language-options button {
        border: 0;
        background: transparent;
        padding: 7px;
        border-radius: 5px;
        cursor: pointer;
      }

      .language-options button:hover { background: #3a3a3a; }
      .language-toggle:focus-visible, .language-options button:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 3px;
      }

      .language-options button.active { background: #3a3a3a; }

      [dir="ltr"] .portfolio-box { text-align: left; }
