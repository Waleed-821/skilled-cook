/* زر التبديل بين الوضعين */
.theme-toggle {
  width: 42px;
  height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #c99b5b;
  border-radius: 9px;
  background: rgba(201, 155, 91, 0.12);
  color: #e6bd7b;
  font-size: 21px;
  cursor: pointer;
  transition: 0.3s ease;
  flex-shrink: 0;
}

