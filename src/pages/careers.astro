
<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>بوابة التوظيف | الطباخ الماهر</title>
    <meta name="description" content="بوابة التوظيف في شركة الطباخ الماهر لخدمات الإعاشة." />
  </head>

  <body>
    <header class="header">
      <a href="/" class="logo">
        <img src="/images/new%20logo.png" alt="شعار الطباخ الماهر" />
        <span>
          <strong>شركة الطباخ الماهر لخدمات الإعاشة</strong>
          <small>SKILLED COOK</small>
        </span>
      </a>
      <a href="/" class="back-link">العودة للرئيسية</a>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">انضم إلى فريقنا</p>
          <h1>بوابة <span>التوظيف</span></h1>
          <p class="description">
            نبحث عن الكفاءات والكوادر الطموحة للانضمام إلى فريق شركة الطباخ
            الماهر لخدمات الإعاشة. يرجى تعبئة البيانات التالية بدقة.
          </p>
        </div>
      </section>

      <section class="application">
        <div class="form-heading">
          <h2>استمارة طلب توظيف</h2>
          <p>يرجى إدخال جميع البيانات المطلوبة</p>
        </div>

        <form id="jobForm">
          <div class="form-grid">

            <div class="field">
              <label for="fullName">الاسم الكامل <span>*</span></label>
              <input id="fullName" name="fullName" type="text"
                placeholder="أدخل الاسم الكامل" required />
            </div>

            <div class="field">
              <label for="idNumber">رقم الهوية / الإقامة <span>*</span></label>
              <input id="idNumber" name="idNumber" type="text"
                placeholder="أدخل رقم الهوية أو الإقامة" required />
            </div>

            <div class="field">
              <label for="nationality">الجنسية <span>*</span></label>
              <select id="nationality" name="nationality" required>
                <option value="">اختر الجنسية</option>
                <option value="السعودية">السعودية</option>
                <option value="ميانمار">ميانمار</option>
                <option value="اليمن">اليمن</option>
                <option value="مصر">مصر</option>
                <option value="السودان">السودان</option>
                <option value="النيجر">النيجر</option>
                <option value="نيجيريا">نيجيريا</option>
                <option value="مالي">مالي</option>
                <option value="تشاد">تشاد</option>
                <option value="other">غير ذلك</option>
              </select>
            </div>

            <div class="field" id="otherNationalityField" hidden>
              <label for="otherNationality">يرجى إدخال الجنسية <span>*</span></label>
              <input id="otherNationality" name="otherNationality"
                type="text" placeholder="اكتب جنسيتك" disabled />
            </div>

            <div class="field">
              <label for="occupation">المهنة في الهوية <span>*</span></label>
              <input id="occupation" name="occupation" type="text"
                placeholder="أدخل المهنة المسجلة في الهوية أو الإقامة" required />
            </div>

            <div class="field">
              <label for="age">العمر <span>*</span></label>
              <input id="age" name="age" type="number" min="18" max="100"
                placeholder="أدخل العمر" required />
            </div>

            <div class="field">
              <label for="phone">رقم الجوال <span>*</span></label>
              <input id="phone" name="phone" type="tel"
                placeholder="أدخل رقم الجوال" required />
            </div>

            <div class="field full">
              <label>هل سبق لك العمل في مطابخ الإعاشة؟ <span>*</span></label>
              <div class="radio-options">
                <label>
                  <input type="radio" name="experience" value="نعم" required />
                  نعم
                </label>
                <label>
                  <input type="radio" name="experience" value="لا" />
                  لا
                </label>
              </div>
            </div>

            <div class="field full">
              <label>هل يمكنك توفير عقد أجير؟ <span>*</span></label>
              <div class="radio-options">
                <label>
                  <input type="radio" name="ajeer" value="نعم" required />
                  نعم
                </label>
                <label>
                  <input type="radio" name="ajeer" value="لا" />
                  لا
                </label>
              </div>
            </div>

          </div>

          <div id="myanmarFields" class="conditional-fields" hidden>
            <h3>بيانات إضافية للمتقدمين من ميانمار</h3>

            <div class="field">
              <label>هل أنت ميانمار بجواز أم ميانمار مقيم؟ <span>*</span></label>
              <div class="radio-options">
                <label>
                  <input type="radio" name="myanmarStatus"
                    value="ميانمار بجواز" disabled />
                  ميانمار بجواز
                </label>
                <label>
                  <input type="radio" name="myanmarStatus"
                    value="ميانمار مقيم" disabled />
                  ميانمار مقيم
                </label>
              </div>
            </div>
          </div>

          <div class="upload-section">
            <label for="identityPhoto">صورة الهوية أو الإقامة <span>*</span></label>
            <p>ارفع صورة واضحة للهوية بصيغة صورة.</p>
            <input id="identityPhoto" name="identityPhoto"
              type="file" accept="image/*" required />

            <div id="previewContainer" hidden>
              <img id="imagePreview" alt="معاينة صورة الهوية" />
              <button type="button" id="removeImage">إزالة الصورة</button>
            </div>
          </div>

          <div class="privacy-note">
            هذه استمارة تجريبية. لن يتم إرسال بياناتك أو حفظها في الوقت الحالي.
          </div>

          <button type="submit" class="submit-button">
            إرسال طلب التوظيف
          </button>

          <p id="formMessage" class="form-message" role="status" hidden></p>
        </form>
      </section>
    </main>

    <footer>
      شركة الطباخ الماهر لخدمات الإعاشة
      <p>الطباخ الماهر .. طبخ ماهر بكل المواسم</p>
    </footer>

    <script>
      const nationality = document.querySelector("#nationality");
      const otherField = document.querySelector("#otherNationalityField");
      const otherInput = document.querySelector("#otherNationality");
      const myanmarFields = document.querySelector("#myanmarFields");
      const myanmarInputs = myanmarFields.querySelectorAll("input");

      const photoInput = document.querySelector("#identityPhoto");
      const previewContainer = document.querySelector("#previewContainer");
      const imagePreview = document.querySelector("#imagePreview");
      const removeImage = document.querySelector("#removeImage");

      const form = document.querySelector("#jobForm");
      const formMessage = document.querySelector("#formMessage");

      let imageUrl = null;

      nationality.addEventListener("change", () => {
        const isOther = nationality.value === "other";
        const isMyanmar = nationality.value === "ميانمار";

        otherField.hidden = !isOther;
        otherInput.disabled = !isOther;
        otherInput.required = isOther;

        myanmarFields.hidden = !isMyanmar;

        myanmarInputs.forEach((input) => {
          input.disabled = !isMyanmar;
          input.required = isMyanmar;

          if (!isMyanmar) {
            input.checked = false;
          }
        });

        if (!isOther) {
          otherInput.value = "";
        }
      });

      photoInput.addEventListener("change", () => {
        const file = photoInput.files?.[0];

        if (imageUrl) {
          URL.revokeObjectURL(imageUrl);
          imageUrl = null;
        }

        previewContainer.hidden = true;
        imagePreview.removeAttribute("src");

        if (!file) return;

        if (!file.type.startsWith("image/")) {
          photoInput.value = "";
          alert("يرجى اختيار ملف صورة.");
          return;
        }

        imageUrl = URL.createObjectURL(file);
        imagePreview.src = imageUrl;
        previewContainer.hidden = false;
      });

      removeImage.addEventListener("click", () => {
        if (imageUrl) {
          URL.revokeObjectURL(imageUrl);
          imageUrl = null;
        }

        photoInput.value = "";
        imagePreview.removeAttribute("src");
        previewContainer.hidden = true;
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();

        formMessage.textContent =
          "اكتملت معاينة البيانات، لكن هذه نسخة تجريبية ولا يتم إرسال الطلب أو حفظه. سيتم تفعيل الإرسال بعد تجهيز نظام الاستقبال.";

        formMessage.hidden = false;
      });
    </script>
  </body>
</html>

<style>
