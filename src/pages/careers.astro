  }

  .upload-section {
    margin-top: 30px;
    padding-top: 25px;
    border-top: 1px solid #ffffff20;
  }

  .upload-section p {
    color: #b8aa97;
    font-size: 13px;
  }

  input[type="file"] {
    display: block;
    width: 100%;
    margin-top: 12px;
    padding: 14px;
    border: 1px dashed #c69a55;
    border-radius: 7px;
    background: #141414;
    color: #d8c7ad;
    font-family: inherit;
  }

  #previewContainer {
    margin-top: 20px;
  }

  #imagePreview {
    display: block;
